# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
# Local Expo module build output (Gradle/Xcode intermediates) — the top-level
# /android and /ios trees are already ignored wholesale since expo prebuild
# regenerates them, but a local module under modules/ is source-controlled and
# only its own build/ directory is generated.
modules/*/android/build/
modules/*/android/.cxx/
modules/*/ios/build/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# tests
coverage/
.jest-cache/

example

# generated native folders
/ios
/android

# Gate secrets — provider API keys never leave the PC
gate/.env
gate/.tokens.json
gate/.pairing.json
gate/.device-tokens.json
gate/.push-tokens.json
gate/.grok-desktop-device.json
gate/secrets/
# The vault names each file after its credential ref, so a mistyped ref puts the
# secret itself in the filename. Never let this directory reach a commit.
gate/credentials/

# Git worktrees
.worktrees/

# Commercial/pricing working documents — not for the public repo.
docs/commercial/

# Scratch/probe scripts and logs (relay-replay-probe.mjs, stop/restart-gate.mjs,
# gate-restart.log). Cited by the pilot packet's sign-off sheet but machine-local;
# never commit them.
temp/
Python/_cache/
