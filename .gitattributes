# The index is always LF. Working trees may differ; the repository does not.
# Without this, a Windows checkout reports every file as modified and hides
# real diffs inside thousands of lines of line-ending churn.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or cmd.exe will not run them.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets — never touch these.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.jks      binary
*.keystore binary
*.p12      binary
*.p8       binary
*.apk      binary
*.aab      binary
