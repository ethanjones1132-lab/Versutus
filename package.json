{
  "name": "versutus",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-widgets"
        ]
      }
    }
  },
  "dependencies": {
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/ui": "~57.0.26",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.31",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-share-intent": "^8.0.1",
    "expo-sharing": "~57.0.24",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "~57.0.0",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "expo-widgets": "~57.0.27",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "tsx": "^4.23.8",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint && eslint gate scripts --max-warnings 0",
    "smoke:gate": "node scripts/live-smoke.mjs",
    "verify": "npm run verify:config && tsc --noEmit && npm run lint && npm run test:coverage && npm run coverage:ratchet && npm run test:gate",
    "verify:config": "tsx ./scripts/verify-config.mts",
    "coverage:ratchet": "tsx ./scripts/coverage-ratchet.mts",
    "test": "jest --runInBand && npm run test:gate",
    "test:coverage": "jest --coverage --maxWorkers=4",
    "test:gate": "cd gate && node --import ./__tests__/fixtures/isolate-credential-vault.mjs --test \"__tests__/*.test.mjs\" \"../scripts/__tests__/*.test.mjs\"",
    "test:voice-worker": "node gate/voice-worker/run-tests.mjs",
    "smoke:gateway-commands": "tsx ./scripts/smoke-gateway-commands.mts",
    "smoke:portal": "tsx ./scripts/smoke-portal.mts",
    "smoke:live": "tsx ./scripts/smoke-live-gateway.mts",
    "smoke:providers": "node ./scripts/smoke-provider-runtime.mjs",
    "smoke:environments": "node ./scripts/smoke-cli-environments.mjs",
    "smoke:wedge": "node ./scripts/smoke-wedge-loop.mjs",
    "smoke:replay": "node ./scripts/replay-probe.mjs",
    "smoke:signoff": "node ./scripts/smoke-signoff.mjs",
    "export:web": "expo export --platform web",
    "serve:web": "node ./scripts/serve-web-demo.mjs",
    "build:android:preview": "eas build --profile preview --platform android",
    "build:android:preview:local": "eas build --profile preview --platform android --local"
  },
  "private": true,
  "workspaces": [
    "gate"
  ],
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.worktrees/",
      "<rootDir>/.claude/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@noble))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "collectCoverageFrom": [
      "src/lib/gateway/**/*.ts"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "src/lib/gateway/": {
        "statements": 38,
        "branches": 30,
        "functions": 40,
        "lines": 40
      }
    }
  }
}
