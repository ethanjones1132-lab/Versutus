{
  "name": "versutus",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/ui": "~57.0.10",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.7",
    "expo-build-properties": "~57.0.10",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-notifications": "~57.0.10",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "tsx": "^4.23.8",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "verify": "npm run verify:config && tsc --noEmit && npm run lint && npm run test:coverage && npm run coverage:ratchet && npm run test:gate",
    "verify:config": "tsx ./scripts/verify-config.mts",
    "coverage:ratchet": "tsx ./scripts/coverage-ratchet.mts",
    "test": "jest --runInBand && npm run test:gate",
    "test:coverage": "jest --runInBand --coverage",
    "test:gate": "cd gate && node --test \"__tests__/*.test.mjs\"",
    "smoke:gateway-commands": "tsx ./scripts/smoke-gateway-commands.mts",
    "smoke:portal": "tsx ./scripts/smoke-portal.mts",
    "smoke:live": "tsx ./scripts/smoke-live-gateway.mts",
    "smoke:providers": "node ./scripts/smoke-provider-runtime.mjs",
    "smoke:environments": "node ./scripts/smoke-cli-environments.mjs",
    "build:android:preview": "eas build --profile preview --platform android",
    "build:android:preview:local": "eas build --profile preview --platform android --local"
  },
  "private": true,
  "workspaces": [
    "gate"
  ],
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.worktrees/"
    ],
    "collectCoverageFrom": [
      "src/lib/gateway/**/*.ts"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "src/lib/gateway/": {
        "statements": 38,
        "branches": 30,
        "functions": 40,
        "lines": 40
      }
    }
  }
}
